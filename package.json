{
  "name": "pokedreamgrid",
  "version": "1.0.3",
  "description": "Rode ate 2 contas de PokeDream ao mesmo tempo, em uma janela so",
  "main": "main.js",
  "author": "soufoka",
  "repository": {
    "type": "git",
    "url": "github:edlucaz/PokeDreamGrid-source"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win --x64",
    "release": "electron-builder --linux AppImage --publish always",
    "release:win": "electron-builder --win --x64 --publish always"
  },
  "keywords": [
    "electron",
    "multi-account",
    "pokedream",
    "idle-game"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.com.pokedream.pokedreamgrid",
    "productName": "PokeDreamGrid",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "tray.png",
      "!node_modules/electron-builder/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "edlucaz",
      "repo": "PokeDreamGrid-source",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
